{
  "name": "mypetmart",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@mypetmart/web",
    "dev:web": "npm run dev --workspace=@mypetmart/web",
    "build:web": "npm run build --workspace=@mypetmart/web",
    "lint:web": "npm run lint --workspace=@mypetmart/web",
    "typecheck:web": "npm run typecheck --workspace=@mypetmart/web",
    "test": "npm run test --workspace=@mypetmart/web",
    "test:web": "npm run test --workspace=@mypetmart/web"
  }
}
